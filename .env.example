# Copy this file to .env and fill in real values.
#
# For local dev (venv):  DATABASE_URL points to localhost:5432
# For Docker Compose:    DATABASE_URL is set automatically — only set the vars below

# ── Required for Docker Compose (prod) ───────────────────────────────────────

# Strong random password for Postgres (used by docker-compose.prod.yml)
DB_PASSWORD=changeme-replace-with-strong-password

# Random secret for internal signing (generate with: openssl rand -hex 32)
SECRET_KEY=changeme-replace-with-random-string

# Seeds the first (admin) user in migration 015 — required, the migration fails without it.
# This is the bootstrap admin: the first Google sign-in with this email lands in the existing data.
# Never used as a key; only to seed and to match that first sign-in.
OWNER_EMAIL=you@gmail.com
OWNER_DISPLAY_NAME=Owner

# ── Login and HTTPS (Part 5) ─────────────────────────────────────────────────
# Set these as Portainer stack environment variables in production — never commit real values.

# Hostname Traefik serves (prod compose builds PUBLIC_BASE_URL=https://$TM_HOSTNAME from it)
TM_HOSTNAME=tm.example.com
# The public origin. Redirect URIs and the cookie Secure flag come from it.
# Local dev: http://localhost:5430 (also add http://localhost:5430/api/auth/google/callback to the
# Google OAuth client's authorized redirect URIs).
PUBLIC_BASE_URL=http://localhost:5430
# Google Cloud OAuth client (type: Web application). With an https PUBLIC_BASE_URL the backend refuses
# to start if these are missing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the 10-minute login-state cookie (PKCE verifier, state, nonce). openssl rand -hex 32
AUTH_STATE_SECRET=
# Sliding session lifetime
SESSION_DAYS=30
# Comma-separated Chrome extension IDs allowed to receive extension tokens (chrome://extensions)
EXTENSION_IDS=
# Traefik / Let's Encrypt (prod only): account email, and a Cloudflare API token with
# Zone → DNS → Edit on the one domain (DNS-01 challenge)
ACME_EMAIL=you@gmail.com
CF_DNS_API_TOKEN=

# ── Market data (Schwab) ─────────────────────────────────────────────────────
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
MARKET_DATA_PROVIDER=schwab

# ── Local dev only (venv) ─────────────────────────────────────────────────────

# Comment this out when using docker-compose (it sets DATABASE_URL automatically)
DATABASE_URL=postgresql+asyncpg://trademinder:password@localhost:5432/trademinder

# ── Optional ──────────────────────────────────────────────────────────────────

# Anthropic API key for AI commentary (leave blank to disable)
ANTHROPIC_API_KEY=

# Scheduler / market hours (Eastern Time)
MARKET_HOURS_START=09:30
MARKET_HOURS_END=16:00
PRICE_REFRESH_INTERVAL_MINUTES=15
ALERT_ENGINE_INTERVAL_MINUTES=15
BRIEFING_GENERATE_TIME=08:00
